# ==============================================================================
# MAPPLE E-COMMERCE — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Safe placeholder template. Do NOT store real production secrets in this file.
# In production, set these variables securely in your hosting dashboards (Render, Vercel, Neon).

# ------------------------------------------------------------------------------
# BACKEND & API CONFIGURATION (Render / Production Server)
# ------------------------------------------------------------------------------
PROJECT_NAME="MAPPLE API"
API_V1_STR="/api/v1"

# JWT Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY="your-secure-random-256-bit-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Database (Neon PostgreSQL connection string)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Allowed CORS Origins (Comma-separated list of deployed frontend URLs and local dev)
CORS_ORIGINS="https://mapple.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:3000"

# Payment Gateway Configuration
# Options: "mock" (built-in interactive simulation) or "razorpay" (live credentials)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Initial Administrative User (Seeded on first launch)
ADMIN_EMAIL="admin@mapple.com"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"

# Optional Server Port (Automatically assigned by Render via $PORT)
PORT=8000

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------
# Public API URL pointing to the deployed backend on Render
# Example: https://mapple-api.onrender.com/api/v1
VITE_API_URL="https://your-render-backend-url.onrender.com/api/v1"
